generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  USER
  HOST
  ADMIN
}

enum SpaceType {
  OFFICE_DESK
  PRIVATE_OFFICE
  MEETING_ROOM
  EVENT_VENUE
  WEDDING_VENUE
  COWORKING_SPACE
}

enum PricingType {
  HOURLY
  DAILY
  BOTH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
  NON_REFUNDABLE
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum HostApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  USD
  EUR
  MDL
}

enum BookingActor {
  GUEST
  HOST
  ADMIN
}

// ==================== AUTH ====================

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String   @unique
  name               String?
  password           String
  role               Role     @default(USER)
  emailVerified      Boolean  @default(false)
  image              String?
  phone              String?
  bio                String?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Soft-delete / GDPR erasure (see DB-004).
  // We never hard-delete users because cascade rules on Booking/Payout would wipe
  // financial history that the platform must retain for tax/accounting (typically
  // 5-7yr). The admin "delete user" endpoint scrubs PII and sets deletedAt; auth
  // and listing paths filter out rows where deletedAt IS NOT NULL.
  deletedAt DateTime?

  // Host-specific fields
  hostVerified           Boolean   @default(false)
  hostRecommended        Boolean   @default(false)
  hostSponsored          Boolean   @default(false)
  hostingSince           DateTime?
  hostApplicationPending Boolean   @default(false)
  // Per-host platform commission as a fraction (0.1 = 10%). Null means use the
  // platform-wide DEFAULT_COMMISSION_RATE env var. The commission is deducted
  // from the host's payout; clients pay the listed price with no extra fee.
  commissionRate         Float?

  // Relations
  sessions          Session[]
  refreshTokens     RefreshToken[]
  hostApplications  HostApplication[]
  passwordResetUses PasswordResetUse[]
  venues            Venue[]
  spaces            Space[] // Spaces hosted by this user
  bookingsAsGuest   Booking[]          @relation("GuestBookings")
  bookingsAsHost    Booking[]          @relation("HostBookings")
  reviews           Review[] // Reviews written by this user
  payouts           Payout[] // Payouts for hosts
  invites           Invite[] // Invitations issued to this user

  @@index([role])
  @@index([deletedAt])
  @@index([hostSponsored, hostRecommended, hostVerified])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Refresh-token rotation chain with reuse detection.
// One row per refresh-token jti issued; old rows are not deleted so we can
// detect reuse of a token that was already exchanged for a new one.
model RefreshToken {
  id         String    @id @default(cuid())
  jti        String    @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  // Set when the token has been exchanged for a new one. A second use of
  // a token where usedAt is non-null is a reuse attempt -> revoke chain.
  usedAt     DateTime?
  // jti of the refresh token that replaced this one (rotation).
  replacedBy String?
  // True if the chain has been revoked (logout, password reset, reuse).
  revoked    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([replacedBy])
}

// Host upgrade applications. Replaces the previous self-promotion flow:
// users now create a PENDING application and an admin must approve via
// the existing PUT /users/:id/role admin endpoint.
model HostApplication {
  id              String                @id @default(cuid())
  userId          String
  status          HostApplicationStatus @default(PENDING)
  applicationData Json? // free-form data submitted with the application (phone, bio, etc.)
  decisionBy      String? // admin user id who decided
  decisionAt      DateTime?
  decisionNotes   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// Single-use enforcement table for password reset tokens. A row is inserted
// when a reset token is consumed; subsequent attempts to use the same jti
// are rejected.
model PasswordResetUse {
  id     String   @id @default(cuid())
  jti    String   @unique
  userId String
  usedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// First-time-access invitations. An admin invites a user by email; the raw
// token is emailed (magic link) and only its sha-256 hash is stored here.
// Accepting an invite sets the user's password + emailVerified=true. Distinct
// from PasswordResetUse: role-agnostic, carries inviter/role context, auditable.
model Invite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  email       String
  role        Role
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Revocation list for access tokens (logout, password change, etc).
// Each entry corresponds to a JWT `jti`. Middleware rejects any access token
// whose `jti` appears here. Expired rows can be reaped by a periodic job
// (see ops follow-up: no scheduler exists yet in this repo).
model RevokedAccessToken {
  jti       String   @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime @default(now())
  reason    String?

  @@index([userId])
  @@index([expiresAt])
}

// ==================== VENUES ====================

model Venue {
  id                      Int     @id @default(autoincrement())
  name                    String
  shortDescription        String  @default("")
  description             String  @default("")
  nameTranslations        Json? // { "ro": "...", "ru": "..." }
  shortDescTranslations   Json? // { "ro": "...", "ru": "..." }
  descriptionTranslations Json? // { "ro": "...", "ru": "..." }
  images                  Json    @default("[]")
  videoUrl                String? // YouTube URL
  workingHours            Json? // { monday: { open: "HH:MM", close: "HH:MM" } | null, ... }

  // Location
  address    String
  city       String
  state      String?
  country    String
  postalCode String?
  latitude   Float?
  longitude  Float?
  currency   Currency @default(USD) // Default currency for new spaces under this venue

  // Platform-admin listing badges. Sponsored outranks recommended, which
  // outranks verified in public featured ordering.
  venueVerified    Boolean @default(false)
  venueRecommended Boolean @default(false)
  venueSponsored   Boolean @default(false)

  // Owner
  hostId String
  host   User   @relation(fields: [hostId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  spaces Space[]

  @@index([hostId])
  @@index([city])
  @@index([isActive])
  @@index([latitude, longitude])
  @@index([venueSponsored, venueRecommended, venueVerified])
}

// ==================== EXCHANGE RATES ====================

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  fromCurrency Currency
  toCurrency   Currency
  rate         Decimal  @db.Decimal(12, 6) // 1 fromCurrency = rate toCurrency (decimal for monetary precision)
  updatedAt    DateTime @updatedAt
  updatedBy    String? // admin user ID who last updated

  @@unique([fromCurrency, toCurrency])
}

// ==================== SPACES ====================

model Space {
  id                      Int         @id @default(autoincrement())
  name                    String
  shortDescription        String
  description             String
  nameTranslations        Json? // { "ro": "...", "ru": "..." }
  shortDescTranslations   Json? // { "ro": "...", "ru": "..." }
  descriptionTranslations Json? // { "ro": "...", "ru": "..." }
  spaceType               SpaceType
  pricingType             PricingType
  pricePerHour            Float? // In dollars
  pricePerDay             Float? // In dollars
  cleaningFee             Float       @default(0) // In dollars
  currency                Currency    @default(USD)
  capacity                Int
  minBookingHours         Int?
  maxBookingHours         Int?
  images                  Json // Array of image URLs
  videoUrl                String? // YouTube URL

  // Location now lives on the related Venue (see DB-010). Read via space.venue.*

  // Settings
  isActive           Boolean            @default(true)
  instantBook        Boolean            @default(false)
  cancellationPolicy CancellationPolicy @default(MODERATE)
  houseRules         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  hostId       String
  host         User           @relation(fields: [hostId], references: [id])
  venueId      Int
  venue        Venue          @relation(fields: [venueId], references: [id])
  categorySlug String
  category     SpaceCategory  @relation(fields: [categorySlug], references: [slug])
  amenities    SpaceAmenity[]
  pricingTiers PricingTier[]
  availability Availability[]
  blockedDates BlockedDate[]
  bookings     Booking[]
  reviews      Review[]

  @@index([hostId])
  @@index([venueId])
  @@index([categorySlug])
  @@index([spaceType])
  @@index([isActive])
}

model SpaceCategory {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  icon        String?
  groupSlug   String
  sortOrder   Int     @default(0)

  group  SpaceCategoryGroup @relation(fields: [groupSlug], references: [slug])
  spaces Space[]

  @@index([groupSlug])
  @@index([groupSlug, sortOrder])
}

model SpaceCategoryGroup {
  id        Int    @id @default(autoincrement())
  name      String
  slug      String @unique
  sortOrder Int    @default(0)

  categories SpaceCategory[]

  @@index([sortOrder])
}

model Amenity {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  icon       String?
  category   String?
  spaceTypes SpaceType[] // Which space types this amenity applies to (empty = all)

  spaces SpaceAmenity[]
}

model SpaceAmenity {
  id        Int @id @default(autoincrement())
  spaceId   Int
  amenityId Int

  space   Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id])

  @@unique([spaceId, amenityId])
  // The composite unique above covers "which amenities does this space have",
  // but the reverse query ("which spaces have amenity X") falls off the
  // composite. AUD-031.
  @@index([amenityId])
}

model PricingTier {
  id      Int    @id @default(autoincrement())
  spaceId Int
  minutes Int // duration in minutes: 60=1h, 240=4h, 480=8h, 1440=1day, 10080=1week, 43200=1month
  label   String // display label: "1 hour", "Half day (4h)", "Full day", "1 week", "1 month"
  price   Float // price in the space's currency

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, minutes])
  @@index([spaceId])
}

model Availability {
  id        Int     @id @default(autoincrement())
  spaceId   Int
  dayOfWeek Int // 0-6 (Sunday-Saturday)
  startTime String // "09:00" format
  endTime   String // "18:00" format
  isOpen    Boolean @default(true)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, dayOfWeek])
}

model BlockedDate {
  id      Int      @id @default(autoincrement())
  spaceId Int
  date    DateTime
  reason  String?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, date])
}

// ==================== BOOKINGS ====================

model Booking {
  id String @id @default(cuid())

  // Guest & Host
  guestId String
  hostId  String
  spaceId Int

  // Booking details
  startDate DateTime
  endDate   DateTime
  startTime String?
  endTime   String?
  guests    Int      @default(1)
  isHourly  Boolean

  // Pricing (in the space's currency, see currency field)
  subtotal     Float
  cleaningFee  Float    @default(0)
  serviceFee   Float
  totalAmount  Float
  currency     Currency @default(USD)
  exchangeRate Decimal  @default(1.0) @db.Decimal(12, 6) // Rate to USD at time of booking

  // Status
  status       BookingStatus @default(PENDING)
  guestMessage String?
  hostMessage  String?

  // Cancellation
  cancelledByRole    BookingActor?
  cancellationReason String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvedAt  DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  // Relations
  guest  User    @relation("GuestBookings", fields: [guestId], references: [id])
  host   User    @relation("HostBookings", fields: [hostId], references: [id])
  space  Space   @relation(fields: [spaceId], references: [id])
  review Review?

  @@index([guestId])
  @@index([hostId])
  @@index([spaceId])
  @@index([status])
  @@index([startDate])
  @@index([createdAt])
}

// ==================== REVIEWS ====================

model Review {
  id      Int     @id @default(autoincrement())
  rating  Int // 1-5
  comment String?

  // Relations
  userId    String
  spaceId   Int
  bookingId String @unique

  // Host response
  hostResponse    String?
  hostRespondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  space   Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([spaceId])
  @@index([userId])
}

// ==================== PAYOUTS ====================

model Payout {
  id String @id @default(cuid())

  hostId      String
  amount      Float // In dollars (long-term target: Decimal(12, 2))
  platformFee Float // In dollars (long-term target: Decimal(12, 2))
  netAmount   Float // In dollars (long-term target: Decimal(12, 2))
  currency    Currency @default(USD)

  status     PayoutStatus @default(PENDING)
  // AUD-030: a GIN index on `bookingIds` is managed by the raw-SQL migration
  // `20260606200000_add_missing_indexes` (Prisma cannot model `USING GIN` on a
  // `String[]` cleanly). `prisma db pull` should preserve it; `prisma migrate
  // dev` will see a column-level index with no schema declaration and that is
  // acceptable for raw-SQL indexes.
  bookingIds String[]

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  host User @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([status])
}
