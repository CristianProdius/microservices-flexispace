# Server
PORT=8003
CORS_ORIGINS="https://spacefly.ai,https://admin.spacefly.ai"

# Database
DATABASE_URL="postgresql://spacefly:change-me@db.example.com:5432/spacefly?sslmode=require"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"

# Password Hashing
BCRYPT_ROUNDS=12

# Kafka
KAFKA_BROKERS="kafka:9092"
KAFKA_ENABLED=true

# Base URL of the admin accept-invite page; the raw invite token is appended
# as ?token=... to build the magic link returned by the invite endpoints.
INVITE_LINK_BASE=https://admin.spacefly.ai/accept-invite
